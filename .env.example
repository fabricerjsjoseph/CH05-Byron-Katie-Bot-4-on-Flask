# Flask Configuration
SECRET_KEY=your-secret-key-here

# LLM API Configuration
# Set to 'true' to enable LLM mode
LLM_ENABLED=false

# URL of your Ollama API endpoint (e.g., deployed on Render)
# Example: https://your-ollama-service.onrender.com
LLM_API_URL=

# Model to use (default: gemma2)
LLM_MODEL=gemma2

# API request timeout in seconds
LLM_TIMEOUT=30
